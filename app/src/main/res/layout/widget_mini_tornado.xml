<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mini_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_mini"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <ImageView
        android:id="@+id/mini_widget_tornado_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/cd_tornado_visual"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_cache_twister_clean" />

    <TextView
        android:id="@+id/mini_widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/mini_widget_idle_label"
        android:textColor="#67E8F9"
        android:textSize="9sp"
        android:textStyle="bold" />
</LinearLayout>
