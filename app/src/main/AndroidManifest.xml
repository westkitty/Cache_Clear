<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Normal install-time permission for subtle tactile feedback during tornado sweep -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Standard Special App Access (user-granted in Settings) for exact StorageStatsManager cache sizes -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Targeted package visibility for launchable apps (avoids broad QUERY_ALL_PACKAGES) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Compact Little 1x1 Mini-Tornado Home Screen Widget -->
        <receiver
            android:name=".widget.MiniTornadoWidgetProvider"
            android:exported="true"
            android:label="@string/mini_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.action.MINI_WIDGET_SWEEP" />
                <action android:name="com.example.action.MINI_WIDGET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mini_tornado_widget_info" />
        </receiver>

        <!-- Resizable 2x2 Cache Twister Home Screen Widget -->
        <receiver
            android:name=".widget.CacheTwisterWidgetProvider"
            android:exported="true"
            android:label="@string/widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.action.WIDGET_TORNADO_SWEEP" />
                <action android:name="com.example.action.WIDGET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cache_twister_widget_info" />
        </receiver>
    </application>

</manifest>
